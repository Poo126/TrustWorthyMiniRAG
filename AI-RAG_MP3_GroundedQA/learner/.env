 # MP3 environment configuration
# ---------------------------------------------------------------
# Copy this file to .env, fill in the real values, then run:
#     source .env
#
# The 'export' keyword is REQUIRED. Without it, the variables are
# set only in your shell session — your Python process won't see them.
# (Common footgun — burned us in W7/W8.)

export OPENAI_API_KEY="voc-9324511921403752284306abca377b3c312.13102004"
export OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# Qdrant Cloud free tier (recommended):
#   https://cloud.qdrant.io/ → create cluster → copy URL + API key
export QDRANT_URL="https://c3c00292-99ee-4db9-b2b0-b927e9e3f80d.us-west-2-0.aws.cloud.qdrant.io"
export QDRANT_API_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6YWFlZDM0MDEtZDNjYS00YTE5LWIzYWMtYzEwNDZhMzczMTBlIn0.IP8fxjU_yu8NP6mAP4iGceHwEqk1Ggs-0zhMxEf2IfU"

# ─── Local Qdrant alternative ─────────────────────────────────
# If you'd rather run Qdrant locally via Docker:
#     docker run -p 6333:6333 -v $(pwd)/qdrant_storage:/qdrant/storage qdrant/qdrant
# then use:
#     export QDRANT_URL="http://localhost:6333"
#     unset QDRANT_API_KEY

# ─── Optional tuning (sensible defaults apply if unset) ───────
# Seconds to wait for Qdrant — raise this if the cloud cluster is slow to respond:
# export QDRANT_TIMEOUT="30"
# Abstention cutoff — lower it if a valid question wrongly abstains, raise it to be stricter:
# export RETRIEVAL_THRESHOLD="0.30"
